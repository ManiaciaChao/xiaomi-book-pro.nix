+static const char *const tm2424_mode_names[] = {
+	"quiet", "turbo", "full-speed", "auto", "eco",
+};
+static const u8 tm2424_mode_values[] = { 0x02, 0x03, 0x04, 0x09, 0x0a };
+
+static ssize_t performance_mode_show(struct device *dev,
+				     struct device_attribute *attr, char *buf)
+{
+	struct bitland_mifs_wmi_data *data = dev_get_drvdata(dev);
+	u8 mode;
+	int ret;
+
+	ret = tm2424_profile_read(data, &mode);
+	if (ret)
+		return ret;
+	for (int i = 0; i < ARRAY_SIZE(tm2424_mode_values); i++)
+		if (tm2424_mode_values[i] == mode)
+			return sysfs_emit(buf, "%s\n", tm2424_mode_names[i]);
+	return -EINVAL;
+}
+
+static ssize_t performance_mode_store(struct device *dev,
+				      struct device_attribute *attr,
+				      const char *buf, size_t count)
+{
+	struct bitland_mifs_wmi_data *data = dev_get_drvdata(dev);
+	int index, ret;
+
+	index = sysfs_match_string(tm2424_mode_names, buf);
+	if (index < 0)
+		return index;
+	ret = tm2424_profile_write(data, tm2424_mode_values[index]);
+	if (ret)
+		return ret;
+	platform_profile_notify(data->pp_dev);
+	return count;
+}
+
+static ssize_t performance_mode_available_show(struct device *dev,
+					       struct device_attribute *attr, char *buf)
+{
+	return sysfs_emit(buf, "quiet turbo full-speed auto eco\n");
+}
+
+static ssize_t performance_mode_raw_show(struct device *dev,
