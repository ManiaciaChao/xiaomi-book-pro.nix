+static int tm2424_profile_read_raw(struct bitland_mifs_wmi_data *data, u8 *mode)
+{
+	struct bitland_mifs_input input = {
+		.operation = WMI_METHOD_GET,
+		.function = WMI_FN_SYSTEM_PER_MODE,
+	};
+	struct bitland_mifs_output output;
+	int ret;
+
+	ret = bitland_mifs_wmi_call(data, &input, &output);
+	if (ret)
+		return ret;
+
+	if (output.operation != 0x80)
+		return -EOPNOTSUPP;
+
+	*mode = output.data[0];
+	return 0;
+}
+
+static int tm2424_profile_read(struct bitland_mifs_wmi_data *data, u8 *mode)
+{
+	u8 raw;
+	int ret;
+
+	ret = tm2424_profile_read_raw(data, &raw);
+	if (ret)
+		return ret;
+
+	switch (raw) {
+	case 0x02:
+	case 0x0a:
+	case 0x09:
+	case 0x03:
+	case 0x04:
+		*mode = raw;
+		return 0;
+	default:
+		dev_warn_ratelimited(&data->wdev->dev,
+				     "Unknown TM2424 profile %#x\n", raw);
+		return -EINVAL;
+	}
+}
+
+static int tm2424_profile_get(struct bitland_mifs_wmi_data *data,
+			      enum platform_profile_option *profile)
+{
+	u8 mode;
+	int ret;
+
+	ret = tm2424_profile_read(data, &mode);
+	if (ret)
+		return ret;
+
+	switch (mode) {
+	case 0x02: /* Quiet */
+		*profile = PLATFORM_PROFILE_LOW_POWER;
+		break;
+	case 0x09: /* Auto */
+		*profile = PLATFORM_PROFILE_BALANCED;
+		break;
+	case 0x04: /* Full-speed */
+		*profile = PLATFORM_PROFILE_PERFORMANCE;
+		break;
+	case 0x03: /* Turbo */
+	case 0x0a: /* Eco */
+		*profile = PLATFORM_PROFILE_CUSTOM;
+		break;
+	default:
+		return -EINVAL;
+	}
+	return 0;
+}
+
+static int tm2424_profile_write(struct bitland_mifs_wmi_data *data, u8 mode)
+{
+	struct bitland_mifs_input input = {
+		.operation = WMI_METHOD_SET,
+		.function = WMI_FN_SYSTEM_PER_MODE,
+	};
+	struct bitland_mifs_output output;
+	u8 actual;
+	int ret;
+
+	input.payload[0] = mode;
+	/* Serialize mode writers across SET and GET without nesting the WMI lock. */
+	guard(mutex)(&data->mode_lock);
+	ret = bitland_mifs_wmi_call(data, &input, &output);
+	if (ret)
+		return ret;
+
+	/* Status alone may signal success even if the firmware ignored SET. */
+	if (output.operation != 0x80)
+		return -EOPNOTSUPP;
+	ret = tm2424_profile_read(data, &actual);
+	if (ret)
+		return ret;
+	return actual == mode ? 0 : -EIO;
+}
+
+static int tm2424_profile_set(struct bitland_mifs_wmi_data *data,
+			      enum platform_profile_option profile)
+{
+	switch (profile) {
+	case PLATFORM_PROFILE_LOW_POWER:
+		return tm2424_profile_write(data, 0x02);
+	case PLATFORM_PROFILE_BALANCED:
+		return tm2424_profile_write(data, 0x09);
+	case PLATFORM_PROFILE_PERFORMANCE:
+		return tm2424_profile_write(data, 0x04);
+	default:
+		return -EOPNOTSUPP;
+	}
+}
