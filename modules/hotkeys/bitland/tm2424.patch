+	struct bitland_mifs_wmi_data *data = dev_get_drvdata(dev);
+	u8 mode;
+	int ret;
+
+	ret = tm2424_profile_read_raw(data, &mode);
+	if (ret)
+		return ret;
+	return sysfs_emit(buf, "0x%02x\n", mode);
+}
