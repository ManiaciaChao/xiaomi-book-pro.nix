+/* Packed little-endian event_type/id/value_low/value_high, matching redmi-wmi. */
+static const struct key_entry tm2424_keymap[] = {
+	{ KE_KEY, 0x00002101, { KEY_MICMUTE } },
+	{ KE_KEY, 0x00012101, { KEY_MICMUTE } },
+	{ KE_KEY, 0x00012301, { KEY_ASSISTANT } },
+	{ KE_KEY, 0x00012401, { KEY_ASSISTANT } },
+	{ KE_KEY, 0x00012501, { KEY_CONTROLPANEL } },
+	{ KE_KEY, 0x00012601, { KEY_CONTROLPANEL } },
+	{ KE_KEY, 0x00000101, { KEY_SWITCHVIDEOMODE } },
+	{ KE_KEY, 0x00001b01, { KEY_CONFIG } },
+	{ KE_KEY, 0x00011b01, { KEY_CONFIG } },
+	{ KE_END, 0 }
+};
